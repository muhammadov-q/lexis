meta {
  name: Vocabulary - sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-up
  body: json
  auth: none
}

body:json {
  {
    "email": "{{vocabularyEmail}}",
    "password": "correct horse"
  }
}

script:pre-request {
  bru.setVar("vocabularyEmail", `bruno-vocabulary-${Date.now()}@example.com`);
}

assert {
  res.status: eq 201
}
